# Used by `pnpm docker:db` (Compose).
# App secrets live in apps/api-gateway/.env and apps/api/.env — not here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fullstack
POSTGRES_PORT=5434
# Relative to docker/docker-compose.yml (keeps data at repo-root data/postgres)
POSTGRES_DATA_DIR=../data/postgres
