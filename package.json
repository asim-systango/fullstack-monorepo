{
  "name": "app-starter",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@app/api-gateway --filter=@app/api --filter=@app/web",
    "dev:backend": "turbo run dev --parallel --filter=@app/api-gateway --filter=@app/api",
    "dev:gateway": "pnpm --filter @app/api-gateway dev",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "start": "turbo run start --parallel --filter=@app/api-gateway --filter=@app/api --filter=@app/web",
    "start:gateway": "pnpm --filter @app/api-gateway start",
    "start:api": "pnpm --filter @app/api start",
    "start:web": "pnpm --filter @app/web start",
    "build": "turbo run build --filter=@app/api-gateway --filter=@app/api --filter=@app/web",
    "build:gateway": "pnpm --filter @app/api-gateway build",
    "build:api": "pnpm --filter @app/api build",
    "build:web": "pnpm --filter @app/web build",
    "lint": "turbo run lint --filter=@app/api-gateway --filter=@app/api --filter=@app/web --filter=@shared/*",
    "lint:sonar": "eslint \"apps/api-gateway/src/**/*.ts\" \"apps/api/src/**/*.ts\" \"apps/web/**/*.{ts,tsx}\" \"libs/*/src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "turbo run typecheck --filter=@app/api-gateway --filter=@app/api --filter=@app/web --filter=@shared/*",
    "typecheck:gateway": "pnpm --filter @app/api-gateway typecheck",
    "typecheck:api": "pnpm --filter @app/api typecheck",
    "typecheck:web": "pnpm --filter @app/web typecheck",
    "migration:run": "pnpm --filter @app/api-gateway migration:run",
    "migration:run:api": "pnpm --filter @app/api migration:run",
    "migration:revert": "pnpm --filter @app/api-gateway migration:revert",
    "migration:revert:api": "pnpm --filter @app/api migration:revert",
    "migration:generate": "pnpm --filter @app/api migration:generate",
    "seed": "pnpm --filter @app/api-gateway seed",
    "test": "pnpm --filter @app/api-gateway exec jest --config ../../jest.config.cjs --testPathPattern='(apps/api-gateway/src|apps/api/src|libs/api-client/src|libs/http/src)'",
    "test:gateway": "pnpm --filter @app/api-gateway test",
    "test:api": "pnpm --filter @app/api test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "docker:db": "sh -c 'if [ -f .env ]; then docker compose --env-file .env -f docker/docker-compose.yml up -d postgres; else docker compose -f docker/docker-compose.yml up -d postgres; fi'",
    "docker:down": "sh -c 'if [ -f .env ]; then docker compose --env-file .env -f docker/docker-compose.yml down; else docker compose -f docker/docker-compose.yml down; fi'",
    "doctor": "sh tools/scripts/doctor.sh",
    "postinstall": "pnpm --filter @shared/env build && pnpm --filter @shared/http build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
