# Nest API Gateway — copy to apps/api-gateway/.env
# Prefer this file over repo-root .env for the gateway (load-env picks the first existing file; no merge).
# JWT_SECRET must match apps/api/.env. If you change api PORT, update API_UPSTREAM_URL to match.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/app
JWT_SECRET=dev-jwt-secret-min-16chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
API_UPSTREAM_URL=http://localhost:3002
