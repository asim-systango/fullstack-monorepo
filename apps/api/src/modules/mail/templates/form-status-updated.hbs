<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Onboarding Request Status Update</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #09090b; color: #f4f4f5; margin: 0; padding: 40px 20px; }
    .container { max-width: 600px; margin: 0 auto; background-color: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 32px; }
    .badge-in_review { display: inline-block; padding: 6px 12px; background: rgba(234, 179, 8, 0.15); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-approved { display: inline-block; padding: 6px 12px; background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-rejected { display: inline-block; padding: 6px 12px; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-pending { display: inline-block; padding: 6px 12px; background: rgba(161, 161, 170, 0.15); color: #a1a1aa; border: 1px solid rgba(161, 161, 170, 0.3); border-radius: 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    h1 { color: #ffffff; font-size: 22px; margin-top: 16px; font-weight: 700; }
    p { color: #a1a1aa; font-size: 15px; line-height: 1.6; margin-bottom: 20px; }
    .status-card { background: #09090b; border: 1px solid #27272a; border-radius: 8px; padding: 20px; margin: 24px 0; }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #18181b; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #71717a; font-size: 13px; font-weight: 500; }
    .detail-value { color: #f4f4f5; font-size: 14px; font-weight: 600; text-align: right; }
    .notes-box { background: #18181b; border-left: 4px solid #3b82f6; padding: 12px 16px; margin-top: 16px; border-radius: 4px; color: #d4d4d8; font-size: 14px; }
    .footer { font-size: 12px; color: #52525b; margin-top: 32px; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    {{#if isInReview}}
      <span class="badge-in_review">Request Under Review</span>
      <h1>Your Onboarding Request is In Review</h1>
      <p>Hello <strong>{{contactName}}</strong>,</p>
      <p>We wanted to update you that your onboarding request for <strong>{{companyName}}</strong> is currently being reviewed by our administration team.</p>
    {{else if isApproved}}
      <span class="badge-approved">Request Approved</span>
      <h1>Congratulations! Your Request Has Been Approved</h1>
      <p>Hello <strong>{{contactName}}</strong>,</p>
      <p>Great news! Your onboarding request for <strong>{{companyName}}</strong> has been <strong>Approved</strong>. Our team is now provisioning your dedicated CRM environment.</p>
      <p style="color: #4ade80; font-weight: 600;">Your login credentials and access link will be shared with you via email very soon.</p>
    {{else if isRejected}}
      <span class="badge-rejected">Request Status Update</span>
      <h1>Update Regarding Your Onboarding Request</h1>
      <p>Hello <strong>{{contactName}}</strong>,</p>
      <p>Thank you for your interest in our CRM platform. After careful review, we regret to inform you that we are unable to approve your onboarding request for <strong>{{companyName}}</strong> at this time.</p>
    {{else}}
      <span class="badge-pending">Status Updated</span>
      <h1>Your Request Status Has Been Updated</h1>
      <p>Hello <strong>{{contactName}}</strong>,</p>
      <p>The status of your onboarding request for <strong>{{companyName}}</strong> has been updated to: <strong>{{status}}</strong>.</p>
    {{/if}}

    <div class="status-card">
      <div class="detail-row">
        <span class="detail-label">Company Name</span>
        <span class="detail-value">{{companyName}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Current Status</span>
        <span class="detail-value">{{status}}</span>
      </div>
    </div>

    {{#if reviewNotes}}
    <div class="notes-box">
      <strong>Admin Notes:</strong> {{reviewNotes}}
    </div>
    {{/if}}

    <p style="margin-top: 24px;">If you have any questions or require further details, please reply directly to this email.</p>

    <div class="footer">
      This is an automated notification from your CRM Platform System.
    </div>
  </div>
</body>
</html>
