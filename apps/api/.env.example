# Splitter API — copy to apps/api/.env
# Supports canonical names (JWT_SECRET, SMTP_*) or Decentra aliases (AUTH_*, MAIL_*, DATABASE_*).
NODE_ENV=development
PORT=3002

# Database — either DATABASE_URL or individual DATABASE_* vars
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=decentra_home
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decentra_home

# Auth — either JWT_* or AUTH_JWT_* aliases
AUTH_JWT_SECRET=change-me-min-16-chars
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
COOKIE_SECURE=false

# CORS — web app origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# Mail — either SMTP_* or MAIL_* aliases (Gmail: port 587, MAIL_REQUIRE_TLS=true)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=no-reply@yourdomain.local
MAIL_DEFAULT_NAME=Api

# Group invite token TTL
GROUP_INVITE_EXPIRES_DAYS=7

# Google OAuth (optional). Callback must match Google Cloud Console:
#   {APP_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
