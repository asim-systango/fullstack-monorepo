# Browser API base — same-origin path; Next rewrites /api/* → API gateway.
NEXT_PUBLIC_API_URL=/api
# Server-only: Nest api-gateway origin used by next.config rewrites.
API_GATEWAY_URL=http://localhost:3001
# Domain API origin for Socket.io live updates (browser).
NEXT_PUBLIC_WS_URL=http://localhost:3002
# Optional space-separated hosts added to CSP connect-src (production WS/API).
# NEXT_PUBLIC_CSP_CONNECT_SRC=https://api.example.com wss://api.example.com
