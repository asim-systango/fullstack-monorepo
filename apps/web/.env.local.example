# Browser API base — same-origin path; Next rewrites /api/* → API gateway.
NEXT_PUBLIC_API_URL=/api
# Canonical site origin for Open Graph / metadataBase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: Nest api-gateway origin used by next.config rewrites and RSC fetches.
API_GATEWAY_URL=http://localhost:3001
