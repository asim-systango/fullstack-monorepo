# syntax=docker/dockerfile:1
# Stub multi-stage build for the Next web app (not used by docker compose).
# Browser calls same-origin /api; Next rewrites to the gateway (API_GATEWAY_URL).
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY libs ./libs
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/web ./apps/web
# Baked into the client bundle / next.config rewrites at build time.
ARG NEXT_PUBLIC_API_URL=/api
ARG API_GATEWAY_URL=http://api-gateway:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_GATEWAY_URL=$API_GATEWAY_URL
RUN pnpm --filter @fullstack/web build

FROM node:20-alpine AS runner
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/web
CMD ["pnpm", "start"]
