# syntax=docker/dockerfile:1
# Multi-stage production image for the Next.js web app (prefer Vercel in prod).
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.18.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/api-gateway/package.json ./apps/api-gateway/
COPY apps/web/package.json ./apps/web/
COPY libs ./libs
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --offline || pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_API_URL=/api
ARG API_GATEWAY_URL=http://api-gateway:3001
ARG NEXT_PUBLIC_WS_URL=http://localhost:3002
ARG NEXT_PUBLIC_CSP_CONNECT_SRC=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV API_GATEWAY_URL=$API_GATEWAY_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_CSP_CONNECT_SRC=$NEXT_PUBLIC_CSP_CONNECT_SRC
RUN pnpm --filter @app/web build

FROM node:20-alpine AS runner
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.18.1 --activate
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
USER node
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
