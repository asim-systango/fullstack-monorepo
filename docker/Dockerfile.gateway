# syntax=docker/dockerfile:1
# Stub multi-stage build for the Nest API gateway / BFF (not used by docker compose).
# Compose remains Postgres-only; use this image when wiring a real deploy.
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api-gateway/package.json ./apps/api-gateway/
COPY libs ./libs
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/api-gateway ./apps/api-gateway
RUN pnpm --filter @repo/env build && pnpm --filter @fullstack/api-gateway build

FROM node:20-alpine AS runner
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/api-gateway
CMD ["pnpm", "start"]
