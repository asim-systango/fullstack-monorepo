# syntax=docker/dockerfile:1
# Stub multi-stage build for the Nest domain API (not used by docker compose).
# Cookie auth lives in Dockerfile.gateway — this image is Bearer JWT + domain modules.
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY libs ./libs
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/api ./apps/api
RUN pnpm --filter @repo/env build && pnpm --filter @fullstack/api build

FROM node:20-alpine AS runner
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/api
CMD ["pnpm", "start"]
